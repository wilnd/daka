<navigation-bar title="记录" back="{{true}}" color="white" background="{{themeColor}}"></navigation-bar>
<view class="page">
  <!-- 记录表单 -->
  <view class="form">
    <!-- 记录类别 -->
    <view class="form-item">
      <view class="category-header">
        <text class="label">为成为更好的自己做的努力</text>
        <text class="clear-btn" bindtap="onClearTag" wx:if="{{selectedTag || selectedCategoryId}}">清除</text>
      </view>
      <!-- 已选择的标签展示 -->
      <view class="selected-tag" wx:if="{{selectedTag}}">
        <text class="tag-text">{{customCategoryDisplay || (selectedTag && categoryIndex >= 0 && subCategoryIndex >= 0 ? (categories[categoryIndex].name || '') + ' · ' + (subCategories[subCategoryIndex].name || '') : '')}}</text>
      </view>

      <!-- 主类别标签（运动、学习、生活、工作） -->
      <view class="category-main-tags">
        <view 
          wx:for="{{categories || []}}" 
          wx:key="id"
          class="main-tag-item {{selectedCategoryId === item.id ? 'active' : ''}}"
          bindtap="onSelectCategory"
          data-categoryid="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>

      <!-- 子类型标签（选中主类别后显示） -->
      <view class="sub-tags-wrapper" wx:if="{{selectedCategoryId && !showCustomSubInput}}">
        <view class="sub-tags">
          <view 
            wx:for="{{subCategories || []}}" 
            wx:key="id"
            wx:for-index="subIdx"
            class="sub-tag-item {{selectedTag === selectedCategoryId + '_' + item.id ? 'active' : ''}}"
            bindtap="onSubCategoryTap"
            data-categoryid="{{selectedCategoryId}}"
            data-subcategoryid="{{item.id}}"
            data-subcategoryname="{{item.name}}"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <!-- 自定义输入框（点击"其他"后显示） -->
      <view class="custom-input-wrapper" wx:if="{{showCustomSubInput}}">
        <view class="custom-input-header">
          <text class="custom-input-label">{{customOtherLabel}}</text>
          <text class="custom-input-tip">请输入自定义内容</text>
        </view>
        <input 
          class="custom-input"
          placeholder="请输入具体内容"
          value="{{customCategoryName}}"
          bindinput="onCustomCategoryInput"
          focus="{{showCustomSubInput}}"
          maxlength="20"
        />
        <view class="custom-input-actions">
          <view class="cancel-btn" bindtap="onCancelCustomInput">取消</view>
          <view class="confirm-btn" bindtap="onConfirmCustomInput">确定</view>
        </view>
      </view>
    </view>

    <!-- 时长输入 -->
    <view class="form-item" wx:if="{{categoryIndex >= 0}}">
      <view class="label-row">
        <text class="label">坚持了多久</text>
        <text class="label-tip">必填，大于 0 可获得成长值</text>
      </view>
      <view class="duration-input">
        <input 
          type="number"
          class="duration-field"
          placeholder="坚持了多久？"
          value="{{duration}}"
          bindinput="onDurationInput"
        />
        <picker 
          range="{{durationUnits || []}}"
          value="{{durationUnitIndex}}"
          bindchange="onDurationUnitChange"
        >
          <view class="duration-unit">
            <text>{{durationUnits[durationUnitIndex]}}</text>
            <text class="arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 记录内容 -->
    <view class="form-item">
      <view class="label-row">
        <text class="label">想说的话</text>
        <text class="label-tip">填写内容可额外获得成长值</text>
      </view>
      <textarea 
        class="content-input"
        placeholder="人类的记忆会褪色，但记录会永远发光"
        maxlength="500"
        bindinput="onTextInput"
        value="{{text}}"
      ></textarea>
      <text class="word-count">{{text.length}}/500</text>
    </view>

    <!-- 照片上传 -->
    <view class="form-item">
      <view class="label-row">
        <text class="label">用相片定格瞬间</text>
        <text class="label-tip">上传照片可额外获得成长值</text>
      </view>
      <view class="photos-grid">
        <view 
          wx:for="{{photos || []}}" 
          wx:key="index"
          class="photo-item"
        >
          <image src="{{item}}" mode="aspectFill" bindtap="onPreviewPhoto" data-url="{{item}}" data-index="{{index}}"></image>
          <view class="remove-btn" bindtap="onRemovePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="add-photo" bindtap="onChoosePhoto" wx:if="{{photos && photos.length < maxPhotos}}">
          <text class="plus">+</text>
          <text class="desc">来一张</text>
        </view>
      </view>
    </view>

    <!-- 发布到成长墙 -->
    <view class="form-item switch-item">
      <view class="switch-left">
        <text class="label">晒到成长墙</text>
        <text class="desc">让大家都看到你的努力（发表记录必须选择记录类别并填写时长）</text>
      </view>
      <switch
        checked="{{isPublishToMoments}}"
        color="#2E8B57"
        bindchange="onToggleMomentsPublish"
      />
    </view>

    <!-- 成长墙可见范围 -->
    <view class="form-item" wx:if="{{isPublishToMoments && momentsGroupRange && momentsGroupRange.length > 1}}">
      <text class="label">成长墙可见</text>
      <picker
        range="{{momentsGroupRange || []}}"
        range-key="name"
        value="{{momentsGroupIndex}}"
        bindchange="onMomentsGroupChange"
      >
        <view class="picker-value">
          <text>{{momentsGroupName || '所有群组'}}</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-bar">
    <button 
      class="submit-btn {{submitting ? 'disabled' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : (mode === 'edit' ? '更新我的成就' : '记录我的成就')}}
    </button>
  </view>
</view>

<!-- 连胜动画 -->
<streak-animation 
  visible="{{showStreakAnimation}}" 
  streak="{{currentStreak}}"
  categoryId="{{checkinResult ? checkinResult.categoryId : 'sports'}}"
  bind:complete="onStreakAnimationComplete"
  bind:skip="onSkipShare"
/>

<!-- 分享海报（传入 currentStreak 与特效一致，避免海报显示 0 天） -->
<share-poster
  visible="{{showSharePoster}}"
  checkinData="{{checkinResult}}"
  isSunday="{{isSunday}}"
  currentStreak="{{currentStreak}}"
  bind:close="onClosePoster"
  bind:skip="onSkipShare"
/>
