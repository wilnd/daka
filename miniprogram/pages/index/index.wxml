<navigation-bar title="我的成长小助手" back="{{false}}" color="white" background="{{navBarColor}}"></navigation-bar>
<scroll-view class="page" scroll-y>
  <view class="container">
    <view wx:if="{{!hasUserInfo}}" class="auth-section">
      <!-- 欢迎区域 -->
      <view class="welcome-area">
        <view class="welcome-icon">🏃‍♂️</view>
        <text class="welcome-title">欢迎来到成长星球</text>
        <text class="welcome-desc">授权一下，让我们一起变强，变富，变好看！</text>
      </view>

      <!-- 头像选择：无头像时显示昵称首字母 -->
      <view class="avatar-area">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar-preview" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-preview avatar-initial"><text class="avatar-initial-text">{{avatarInitial || '?'}}</text></view>
          <view class="avatar-edit-badge">
            <text class="edit-icon">✎</text>
          </view>
        </button>
        <text class="avatar-tip">戳我换头像</text>
      </view>

      <!-- 昵称输入 -->
      <view class="nickname-area">
        <input
          id="nicknameInput"
          type="text"
          class="nickname-input"
          placeholder="江湖称号（昵称）"
          placeholder-class="nickname-placeholder"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          value="{{userInfo.nickName}}"
        />
      </view>

      <!-- 确认按钮 -->
      <button class="btn-primary confirm-auth" bindtap="onConfirmAuth">
        <text class="btn-text">准备起飞</text>
      </button>

      <!-- 隐私说明 -->
      <text class="privacy-tip">放心，我们只关心你有没有运动，不关心你几点睡~</text>
      <text class="browse-hint">可先浏览组织、成长墙、我的等页面，使用功能时再登录</text>
    </view>
    <view wx:elif="{{loading}}" class="skeleton-wrap">
      <view class="skeleton-card">
        <view class="skeleton skeleton-title"></view>
        <view class="skeleton skeleton-btn"></view>
      </view>
      <view class="skeleton-card">
        <view class="skeleton skeleton-text"></view>
        <view class="skeleton skeleton-text short"></view>
      </view>
      <view class="skeleton-card">
        <view class="skeleton skeleton-stat"></view>
        <view class="skeleton skeleton-stat"></view>
        <view class="skeleton skeleton-stat"></view>
      </view>
    </view>
    <view wx:else class="main">
      <!-- 打卡卡片：无论是否加入组织都显示 -->
        <view
          class="checkin-card"
          style="--btn-color: {{checkinCardColor}}; --btn-color-rgb: {{checkinCardColorRgb}}"
        >
          <view class="checkin-status {{checkedToday ? 'checked' : ''}}">
            <text class="status-text">{{checkedToday ? '今日已达标' : '骚年，该动起来了！'}}</text>
          </view>
          <view class="checkin-btn-wrapper">
            <button
              class="btn-primary checkin-btn {{checkedToday ? 'checked' : ''}} {{checkinAnimating ? 'animating' : ''}}"
              style="--btn-color: {{checkinCardColor}}; --btn-color-rgb: {{checkinCardColorRgb}}"
              hover-class="btn-hover"
              bindtap="onCheckin"
              disabled="{{checkinAnimating}}"
            >
              <text wx:if="{{checkinAnimating}}">提交中...</text>
              <text wx:elif="{{checkedToday}}">太棒了</text>
              <text wx:else>记录今日份成就</text>
            </button>
            <view wx:if="{{checkedToday}}" class="success-badge">
              <text class="badge-icon">✓</text>
            </view>
          </view>
        </view>
        <view wx:if="{{stats}}" class="stats-card">
          <!-- 主要数据：连胜展示 -->
          <view class="stats-highlight">
            <view class="highlight-main">
              <view class="streak-fire">🔥</view>
              <text class="streak-value">{{stats.streak}}</text>
              <text class="streak-unit">天</text>
            </view>
            <text class="streak-label">当前连胜</text>
            <view wx:if="{{stats.streak >= 7}}" class="streak-badge">
              <text>超神！</text>
            </view>
          </view>
          
          <!-- 次要数据网格 -->
          <view class="stats-grid">
            <view class="stat-item">
              <view class="stat-icon trophy">🏆</view>
              <view class="stat-content">
                <text class="stat-value">{{stats.bestStreak || 0}}</text>
                <text class="stat-label">最佳连胜</text>
              </view>
            </view>
            <view class="stat-item">
              <view class="stat-icon calendar">📅</view>
              <view class="stat-content">
                <text class="stat-value">{{stats.totalDays}}</text>
                <text class="stat-label">有记录的天</text>
              </view>
            </view>
            <view class="stat-item">
              <view class="stat-icon record">📊</view>
              <view class="stat-content">
                <text class="stat-value">{{stats.totalCount}}</text>
                <text class="stat-label">总记录数</text>
              </view>
            </view>
            <view class="stat-item">
              <view class="stat-icon rest">😴</view>
              <view class="stat-content">
                <text class="stat-value warn">{{stats.missStreak}}</text>
                <text class="stat-label">摸鱼天数</text>
              </view>
            </view>
          </view>
          
          <!-- 成就进度条 -->
          <view wx:if="{{stats.totalDays > 0}}" class="stats-progress">
            <view class="progress-header">
              <text class="progress-label">成长进度</text>
              <text class="progress-percent">{{stats.progressPercent}}%</text>
            </view>
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{stats.progressPercent}}%"></view>
            </view>
            <text class="progress-tip">{{stats.totalDays}} / 30 天，{{stats.totalDays >= 30 ? '你已经是个老手了！' : '再坚持' + (30 - stats.totalDays) + '天就是一个月啦！'}}</text>
          </view>
        </view>

        <!-- 正在进行的自律计划 -->
        <view wx:if="{{currentGroup && activeGoals.length > 0}}" class="goals-card">
          <view class="goals-header">
            <text class="goals-title">正在进行的自律计划</text>
            <text class="goals-view-all" bindtap="goToAllGoals">制定自律计划</text>
          </view>
          <view class="goals-list">
            <view
              class="goal-item {{item.status === 'completed' ? 'completed' : ''}} {{item.status === 'failed' ? 'failed' : ''}}"
              wx:for="{{activeGoals}}"
              wx:key="_id"
              bindtap="goToGoalProgress"
              data-id="{{item._id}}"
            >
              <view class="goal-item-main">
                <view class="goal-item-header">
                  <view class="goal-item-title-wrap">
                    <text class="goal-item-title">{{item.title}}</text>
                    <text class="goal-item-desc" wx:if="{{item.description}}">{{item.description}}</text>
                  </view>
                  <text class="goal-item-period">{{item.period === 'daily' ? '每日' : item.period === 'weekly' ? '每周' : '每月'}}</text>
                </view>
                <view class="goal-item-progress">
                  <view class="goal-progress-bar">
                    <view class="goal-progress-fill" style="width: {{item.progress.percent}}%"></view>
                  </view>
                  <text class="goal-progress-text">{{item.progress.current}}/{{item.progress.target}}</text>
                </view>
                <view class="goal-item-status">
                  <text wx:if="{{item.status === 'in_progress'}}">进行中</text>
                  <text wx:elif="{{item.status === 'completed'}}">已完成</text>
                  <text wx:elif="{{item.status === 'failed'}}">未完成</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 排行榜：有组织时显示完整排行榜 -->
        <view wx:if="{{currentGroup}}" class="rank-card">
          <view class="rank-header">
            <view class="group-selector" bindtap="showSwitchGroup">
              <text class="rank-title">{{currentGroup.name || '测试小组'}}</text>
              <text class="arrow">▼</text>
            </view>
          </view>
          <view class="rank-tabs">
            <view class="rank-tab {{rankType === 'week' ? 'active' : ''}}" bindtap="switchRank" data-type="week">本周</view>
            <view class="rank-tab {{rankType === 'month' ? 'active' : ''}}" bindtap="switchRank" data-type="month">本月</view>
            <view class="rank-tab {{rankType === 'all' ? 'active' : ''}}" bindtap="switchRank" data-type="all">总榜</view>
          </view>
          <!-- 多维度切换 -->
          <view class="dimension-tabs">
            <view class="dimension-tab {{rankDimension === 'days' ? 'active' : ''}}" bindtap="switchRankDimension" data-dimension="days">记录天数</view>
            <view class="dimension-tab {{rankDimension === 'minutes' ? 'active' : ''}}" bindtap="switchRankDimension" data-dimension="minutes">肝时长</view>
            <view class="dimension-tab {{rankDimension === 'score' ? 'active' : ''}}" bindtap="switchRankDimension" data-dimension="score">成长值</view>
          </view>
          <!-- 统计对比 - 显示所有群组的汇总数据 -->
          <view wx:if="{{allStats && !statsLoading}}" class="stats-compare">
            <view class="compare-header">
              <text class="compare-title">全部群组汇总</text>
            </view>
            <view class="compare-stats">
              <view class="compare-item">
                <text class="compare-value">{{rankDimension === 'minutes' ? allStats.totalMinutes : rankDimension === 'days' ? allStats.totalDays : allStats.avgScore}}</text>
                <text class="compare-label">{{rankDimension === 'minutes' ? '分钟' : rankDimension === 'days' ? '天' : '成长值'}}</text>
              </view>
              <view class="compare-item group">
                <text class="compare-value">{{allStats.totalCheckins}}</text>
                <text class="compare-label">总记录</text>
              </view>
            </view>
            <view class="compare-percent">
              <text>连续 {{allStats.streak}} 天 / 最佳 {{allStats.bestStreak}} 天</text>
            </view>
          </view>
          <view wx:if="{{statsLoading}}" class="rank-loading">正在算账...啊不，算排名...</view>
          <view wx:elif="{{!currentRankList || currentRankList.length === 0}}" class="rank-empty">暂无数据</view>
          <view wx:else class="rank-list">
            <view wx:for="{{currentRankList || []}}" wx:key="openid" class="rank-item" bindtap="onViewUserMoments" data-openid="{{item.openid}}" data-nick-name="{{item.nickName}}" data-avatar-url="{{item.avatarUrl}}">
              <view class="rank-index {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
              <image wx:if="{{item.avatarUrl}}" class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="rank-avatar rank-avatar-initial"><text>{{item.avatarInitial || '?'}}</text></view>
              <text class="rank-name">{{item.nickName}}</text>
              <text class="rank-streak">{{rankDimension === 'minutes' ? item.totalMinutes + ' 分钟' : rankDimension === 'days' ? item.checkinDays + ' 天' : item.avgScore + ' 成长值'}}</text>
            </view>
          </view>
        </view>
        <!-- 未加入组织时：排行榜占位，提示加入组织后显示 -->
        <view wx:else class="rank-card rank-card-placeholder">
          <view class="rank-header">
            <text class="rank-title">排行榜</text>
          </view>
          <view class="rank-empty-placeholder">
            <text class="rank-placeholder-desc">加入组织后显示排行榜</text>
            <view class="rank-placeholder-actions">
              <button class="btn-primary" bindtap="goCreateGroup">创建组织</button>
              <button class="btn-secondary" bindtap="goJoinGroup">加入组织</button>
            </view>
          </view>
        </view>
    </view>
  </view>
</scroll-view>

<!-- 切换组织弹窗 -->
<view class="modal {{showSwitchModal ? 'show' : ''}}" bindtap="hideSwitchGroup" wx:if="{{showSwitchModal}}">
  <view class="modal-content" catchtap="stopPropagation">
    <text class="modal-title">切换到哪个组织</text>
    <view wx:for="{{groups || []}}" wx:key="_id" class="group-option {{item._id === currentGroup._id ? 'active' : ''}}" bindtap="selectGroup" data-id="{{item._id}}">
      <view class="group-option-info">
        <text>{{item.name}}</text>
        <text class="meta">成员 {{item.memberCount || 0}} 人</text>
      </view>
      <view class="group-option-actions">
        <text wx:if="{{item._id === currentGroup._id}}" class="default-tag">当前</text>
        <button wx:else class="btn-set-default" catchtap="setDefaultGroup" data-id="{{item._id}}">设为默认</button>
      </view>
    </view>
    <view class="modal-actions">
      <button class="btn-text" bindtap="goCreateGroup">创建新组织</button>
      <button class="btn-secondary" bindtap="hideSwitchGroup">取消</button>
    </view>
  </view>
</view>
